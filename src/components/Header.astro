---
const currentPath = Astro.url.pathname;
---

<header>
    <nav>
        <input type="checkbox" id="menu-toggle" aria-label="Toggle menu"/>
        <label for="menu-toggle">
            <span></span>
            <span></span>
            <span></span>
        </label>
        <ul>
            <li>
                <a 
                    href="/" 
                    class={currentPath === "/" ? "active" : ""}
                    aria-current={currentPath === "/" ? "page" : undefined}
                >
                About
                </a>
            </li>
            <li>
                <a 
                    href="/notes-in-mathematics/" 
                    class={currentPath === "/notes-in-mathematics/" ? "active" : ""}
                    aria-current={currentPath === "/notes-in-mathematics/" ? "page" : undefined}
                >
                    Notes in Math
                </a>
            </li>
            <li>
                <a id="cv-page" href="/cv/" class={currentPath === "/cv/" ? "active" : ""} aria-current={currentPath === "/cv/" ? "page" : undefined}>
                    <span>CV</span>
                </a>
            </li>
        </ul>
    </nav>
</header>
