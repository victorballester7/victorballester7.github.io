---
import cv from '../content/cv.json';
import { appIcons } from '../data/app-icons';

const currentPath = Astro.url.pathname;
const year = new Date().toLocaleDateString('en-EN', {
    year: 'numeric'
});

const appLinks = [
    {
        name: 'Email',
        className: 'email',
        href: `mailto:${cv.personal.contact.email}`,
        icon: appIcons.email
    },
    {
        name: 'Telegram',
        className: 'telegram',
        href: `https://telegram.me/${cv.personal.contact.telegram}`,
        icon: appIcons.telegram
    },
    {
        name: 'WhatsApp',
        className: 'whatsapp',
        href: `https://wa.me/${cv.personal.contact.phone.replace('+', '')}`,
        icon: appIcons.whatsapp
    },
    {
        name: 'GitHub',
        className: 'github',
        href: `https://github.com/${cv.personal.contact.github}`,
        icon: appIcons.github
    }
];
---

<footer>
    <section>
        <h3>Víctor Ballester Ribó</h3>
        <p>PhD Student in Aeronautics</p>
        <p>Imperial College London</p>
    </section>

    <nav aria-label="Footer navigation">
        <ul>
            <li>
                <a 
                    href="/" 
                    class={currentPath === "/" ? "active" : ""}
                    aria-current={currentPath === "/" ? "page" : undefined}
                >
                About
                </a>
            </li>
            <li>
                <a 
                    href="/notes-in-mathematics/" 
                    class={currentPath === "/notes-in-mathematics/" ? "active" : ""}
                    aria-current={currentPath === "/notes-in-mathematics/" ? "page" : undefined}
                >
                    Notes in Math
                </a>
            </li>
            <li><a id="cv-page-footer" href="/cv/" class={currentPath === "/cv/" ? "active" : ""} aria-current={currentPath === "/cv/" ? "page" : undefined}>CV</a></li>
        </ul>
    </nav>

    <address>
        {appLinks.map(app => (
            <a href={app.href} class={app.className} title={app.name} target={app.href.startsWith('http') ? '_blank' : undefined} rel={app.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox={app.icon.viewBox} aria-label={app.name} role="img">
                    {app.icon.paths.map((path, index) => <path class={app.className === 'telegram' ? `telegram-path-${index + 1}` : undefined} d={path} />)}
                </svg>
            </a>
        ))}
    </address>

    <strong>&copy; {year} Víctor Ballester Ribó</strong>
</footer>
